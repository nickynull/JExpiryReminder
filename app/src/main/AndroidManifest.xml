<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ML Kit 的 bundled OCR 会把 INTERNET / ACCESS_NETWORK_STATE 合并进来。
      离线识别本身不联网，但「跨设备分享」要在同一 Wi-Fi 下直连对端设备，
      所以这两个权限不再移除——代码里没有任何访问互联网的请求：
      传输只走局域网 Socket（TCP），设备发现只走 mDNS（NsdManager）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 流体云 / Android 16 Live Updates：非运行时权限，仅用于把 7 天内到期汇总提升为胶囊，
         不涉及任何隐私数据；系统不支持或用户在设置里关闭时自动降级为普通通知。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
      精确闹钟：
      USE_EXACT_ALARM（API 33+）安装即授予、用户不可撤销。targetSdk 33+ 的新装应用在
      Android 14+ 上拿不到 SCHEDULE_EXACT_ALARM（默认拒绝），排程会退化成非精确闹钟，
      后台被 Doze / 待机分桶推迟甚至吞掉——这是「退出后不弹提醒」的根因。
      注意：Google Play 对该权限有政策审核（仅限闹钟/日历类应用），本应用只通过
      GitHub 发布 APK，不上架 Play；若将来要上架，删掉这一行改回主动请求
      SCHEDULE_EXACT_ALARM 即可。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 设置页「忽略电池优化」入口用；仅用于让提醒不被省电策略掐掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      彻底关闭预测性返回（predictive back）。

      显式写 false 而不是删掉这行：targetSdk 35 起系统默认值变为 true，
      删掉等于「跟随系统默认」，往后升 targetSdk 会被悄悄重新打开。
      本应用的返回全部由自己接管——二级页走 AnimatedContent 转场、
      左边缘拖拽走 BackDragStrip、图片查看器走缩回缩略图，
      系统那一层预测性返回动画只会与这些自绘动画叠在一起。
      关闭后系统走传统返回路径，OnBackPressedDispatcher 仍然正常分发，
      各页的 BackHandler 不受影响。
    -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          singleTop：长按桌面图标的快捷方式启动时，应用若已在前台就复用当前实例、
          走 onNewIntent 跳页，而不是再压一个 MainActivity 上去（否则返回会回到旧页）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按图标弹出的快捷方式（res/xml/shortcuts.xml），一装即有，无需先启动应用 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          其它会让排程失效的系统事件：精确闹钟授权变化（撤销时系统会取消全部精确闹钟）、
          系统时间/时区变更、覆盖安装升级。都只由系统发送，exported 保持 false。
        -->
        <receiver
            android:name=".notify.ReminderSyncReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：标准 AppWidgetProvider，ColorOS 万能卡片/原子组件按此协议发现。
             三个尺寸分别注册，卡片库里可单独添加；列表数据只读本机 data.json。 -->
        <receiver
            android:name=".widget.ExpiryWidgetSmall"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expiry_widget_small" />
        </receiver>
        <receiver
            android:name=".widget.ExpiryWidgetMedium"
            android:exported="true"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expiry_widget_medium" />
        </receiver>
        <receiver
            android:name=".widget.ExpiryWidgetLarge"
            android:exported="true"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expiry_widget_large" />
        </receiver>

        <service
            android:name=".widget.ExpiryWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
