<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 小组件的选择器预览：静态样例数据，视觉与真实渲染一致（真实卡片见 widget_medium.xml） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="14dp">

    <!-- 标题行：单一总数 N 提醒 + 右侧圆钮（图标白色，同 Provider 浅色主题赋值） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="15"
            android:textColor="#1F2D3D"
            android:textSize="16dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="提醒"
            android:textColor="#E6A23C"
            android:textSize="10dp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_cam_bg_light"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_camera"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="15dp" />
    </LinearLayout>

    <!-- 列表行：单行紧凑式，与 widget_item.xml 同款（minHeight 26dp、名 13dp、天数 12dp 加粗） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_expired"
        android:minHeight="26dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:tint="#67C23A"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="牛奶"
            android:textColor="#1F2D3D"
            android:textSize="13dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="已过期 3 天"
            android:textColor="#F56C6C"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_soon"
        android:minHeight="26dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:tint="#409EFF"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="感冒灵颗粒"
            android:textColor="#1F2D3D"
            android:textSize="13dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="还有 3 天"
            android:textColor="#E6A23C"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_month"
        android:minHeight="26dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:tint="#E6A23C"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="面膜"
            android:textColor="#1F2D3D"
            android:textSize="13dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="还有 18 天"
            android:textColor="#409EFF"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_normal"
        android:minHeight="26dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:tint="#67C23A"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="洗衣液"
            android:textColor="#1F2D3D"
            android:textSize="13dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="还有 58 天"
            android:textColor="#67C23A"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
